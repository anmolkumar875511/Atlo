# Copy to .env and adjust. Every value is optional; the defaults below are what the app uses.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info                 # fatal | error | warn | info | debug | trace | silent

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Optional GitHub token: raises the download rate limit (no scopes needed for public repos)
GITHUB_TOKEN=

# Ingestion limits (bytes unless noted)
MAX_ZIP_BYTES=104857600            # 100 MB compressed download
MAX_UNCOMPRESSED_BYTES=314572800   # 300 MB after unzip
MAX_FILE_BYTES=1048576             # 1 MB per file
MAX_FILES=20000
DOWNLOAD_TIMEOUT_MS=30000

# Snapshot cache (in memory)
CACHE_MAX_ENTRIES=20
CACHE_TTL_MS=1800000               # 30 minutes

# Parsing: "auto" = CPU count minus one (max 4), 0 = parse on the main thread
WORKER_THREADS=auto
WORKER_MIN_FILES=40
ANALYSIS_CACHE_ENTRIES=20000       # per-file analysis cache, 0 turns it off

# Git churn (Health view)
CHURN_ENABLED=true
CHURN_TIMEOUT_MS=60000
CHURN_WINDOW_DAYS=365

# Rate limits per minute, per client
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=300
