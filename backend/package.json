{
    "name": "backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "node --watch index.js",
        "start": "NODE_ENV=production node index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm test"
    },
    "dependencies": {
        "compression": "^1.8.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.0",
        "fflate": "^0.8.2",
        "helmet": "^8.0.0",
        "pino": "^9.6.0",
        "pino-http": "^10.4.0",
        "tree-sitter": "0.21.1",
        "tree-sitter-javascript": "0.21.4",
        "tree-sitter-python": "0.21.0",
        "tree-sitter-typescript": "0.21.2",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "eslint": "^9",
        "globals": "^16",
        "pino-pretty": "^13.0.0",
        "prettier": "^3",
        "supertest": "^7.0.0",
        "vitest": "^3.0.0"
    },
    "description": "Atlo API: GitHub repository ingestion (Express, MVC)",
    "engines": {
        "node": ">=20"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "tree-sitter@0.21.1": true,
        "tree-sitter-javascript@0.21.4": true,
        "tree-sitter-python@0.21.0": true,
        "tree-sitter-typescript@0.21.2": true
    }
}
